    "quality_profile": "showcase",
    "viewBox": [
      1270,
      630
    ],
    "views": [
      {
        "id": "mcp-path",
        "label": "MCP request path",
        "focus": [
          "host",
          "mcp",
          "broker",
          "guard",
          "upstream",
          "ripwire"
        ],
        "note": "An agent tool call crosses stdio twice: into the broker, then into ripwire --mcp."
      },
      {
        "id": "hooks",
        "label": "Automatic mode (hooks)",
        "focus": [
          "host",
          "hook",
          "broker",
          "state",
          "git"
        ],
        "note": "Host hooks run the broker in-process, write per-session fingerprints to disk and ask git whether a shell command changed files."
      },
      {
        "id": "status-bar",
        "label": "Status bar",
        "focus": [
          "host",
          "statusline",
          "state",
          "hook"
        ],
        "note": "Hooks publish a per-session projection; the statusline command only reads it and never starts ripwire."
      },
      {
        "id": "optional",
        "label": "Optional enrichment",
        "focus": [
          "broker",
          "notes",
          "online",
          "jev"
        ],
        "note": "Local-model notes and the --online classifier only add to context_for_task."
      },
      {
        "id": "memory",
        "label": "Memory (--memory)",
        "focus": [
          "broker",
          "memstore",
          "memworker",
          "jev"
        ],
        "note": "The tools spool observations and recall from the store; a worker started by serve --memory enriches them through Jev."
      }
    ],
