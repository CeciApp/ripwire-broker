{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/ripwire-broker hook claude-code user-prompt-submit --workspace /path/to/repo",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/ripwire-broker hook claude-code post-tool-use --workspace /path/to/repo",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/ripwire-broker hook claude-code stop --workspace /path/to/repo",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
